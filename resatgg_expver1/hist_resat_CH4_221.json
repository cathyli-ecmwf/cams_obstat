{
    "access": [
        "public"
    ],
    "activate": "now",
    "application": "pgf",
    "class": "time_series",
    "description": "Timeseries of statistics for CH4 from IASI",
    "eccharts": false,
    "enabled": true,
    "expire": {
        "cycle": 2
    },
    "help": "Time series of area averages",
    "thumbnail_original_size": true,
    "in_production": true,
    "layers": [
        {
            "availability": {
                "service": "availability"
            },
            "class": "netcdf",
            "plot": {
                "service": "plot_netcdf"
            },
            "retrieve": {
                "data": {
                    "expver": "$expver",
                    "package": "obstat",
                    "step": 0,
                    "stream": "oper",
                    "class": "ob",
                    "domain": "g",
                    "type": "an",
                    "base_time": "$base_time",
                    "label": "$label"
                },
                "service": "get_url"
            },
            "values": {
                "expver": "0001",
                "period": "Last 2 months",
                "area": "Globe",
                "satellite": "METOP-C",
                "flag": "All",
                "level": "1100.0_0.01hPa",
                "label": "hist_from_resatak_0011_DA_ozone_CH4_221_short"
            }
        }
    ],
    "long_title": "Time series of area averages",
    "name": "hist_resatak_CH4_iasi",
    "owner": "ecmwf",
    "package": "cams_ghg_monitoring",
    "opencharts": true,
    "tags": {
        "Category": [
            "Satellite Data"
        ],
        "Data Stream": [
            "Normal delivery"
        ],
        "Experiment": [
            "GHG"
        ],
        "Instrument": [
            "IASI"
        ],
        "Parameter": [
            "CH4"
        ],
        "Component": [
            "OBSTAT"
        ]
    },
    "title": "Timeseries of statistics for CH4 from IASI",
    "type": "product",
    "variables": [
        {
            "name": "satellite",
            "title": "Satellite",
            "type": "choice",
            "values": [
                "METOP-C"
            ],
            "label": [
                "METOP-C"
            ]
        },
        {
            "name": "area",
            "title": "Area",
            "type": "choice",
            "values": [
                "Globe",
                "North_Pole",
                "NHem_Extra_Tropics",
                "Tropics",
                "SHem_Extra_Tropics",
                "South_Pole"
            ]
        },
        {
            "name": "level",
            "title": "Layer",
            "type": "choice",
            "values": [
                "1100.0_0.01hPa"
            ],
            "labels": [
                "Total column"
            ]
        },
        {
            "name": "flag",
            "title": "Flag",
            "type": "choice",
            "values": [
                "All",
                "Used"
            ],
            "labels": [
                "All",
                "Used"
            ]
        },
        {
            "name": "label",
            "title": "period",
            "type": "choice",
            "values": [
                "hist_from_resatak_0011_DA_ozone_CH4_221_short",
                "hist_from_resatak_0011_DA_ozone_CH4_221_medium",
                "hist_from_resatak_0011_DA_ozone_CH4_221_long"
            ],
            "labels": [
                "Last 2 months",
                "Last 12 months",
                "Long time series"
            ]
        }
    ],
    "viewport": {
        "height": 900,
        "width": 550
    },
    "widgets": [
        "basic"
    ],
    "format": "png",
    "inline_plot_structure": {
        "variable_title": [
            "STATISTICS FOR GHG CH4 FROM $satellite/IASI ($area)",
            "CHANNEL=$level $flag DATA (TIME STEP=$step HOURS)",
            "Area $areadef (Over Sea)",
            "Exp=$expver  LAST TIME WINDOW ($last_time)"
        ],
        "title_layout": {
            "title_panel_height": "16",
            "style": {
                "text_colour": "black",
                "text_font_size": "0.6"
            }
        },
        "panel_layout": {
            "rows": 4,
            "columns": 1
        },
        "map": {
            "legend": {
                "legend_entry_text_width": "80.0",
                "text_font_size": "0.45",
                "legend_column_count": "2"
            }
        },
        "thumbnail_original_size": true,
        "template": "template-histogram.json",
        "page_structure": [
            {
                "graph": {
                    "colours": "RED,BLUE,RED,BLUE",
                    "styles": "SOLID, SOLID,DASH,DASH",
                    "titles": "OBS-AN,OBS-FG,OBS-FG(bcor),OBS-AN(bcor)",
                    "thickness": "2,3,2,3"
                },
                "netcdf": {
                    "variables_y": "andep,fgdep,fgdep_bcor,andep_bcor"
                },
                "map": {
                    "legend": {
                        "legend_entry_text_width": "90.0",
                        "text_font_size": "0.45",
                        "legend_column_count": "4"
                    }
                }
            },
            {
                "graph": {
                    "colours": "BLUE, RED",
                    "styles": "SOLID, SOLID",
                    "titles": "stdv(OBS-FG), stdv(OBS-AN)"
                },
                "netcdf": {
                    "variables_y": "fgdep_stdv, andep_stdv"
                },
                "map": {
                    "legend": {
                        "legend_entry_text_width": "80.0",
                        "text_font_size": "0.45",
                        "legend_column_count": "2"
                    }
                }
            },
            {
                "graph": {
                    "colours": "GREEN, BLUE, RED",
                    "styles": "SOLID, SOLID, SOLID",
                    "titles": "fg , an, obs"
                },
                "netcdf": {
                    "variables_y": "fg, an, obs"
                }
            },
            {
                "graph": {
                    "colours": "MAGENTA, BLUE, KELLY_GREEN",
                    "styles": "SOLID, DASH, DOT",
                    "titles": "count, all, used",
                    "thickness": "4,3,3"
                },
                "netcdf": {
                    "variables_y": "count_displayed, count_all, count_used"
                }
            }
        ]
    }
}